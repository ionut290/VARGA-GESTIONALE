{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varga Gestionale",
  "version": "0.1.1",
  "identifier": "it.varga.gestionale",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Varga Gestionale",
        "url": "https://ionut290.github.io/VARGA-GESTIONALE/?desktop=1",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Varga Gestionale",
    "copyright": "Avola Societa Cooperativa",
    "category": "Business",
    "shortDescription": "Gestionale aziendale per commesse, preventivi e cantieri",
    "longDescription": "Varga Gestionale Desktop consente di gestire commesse, preventivi, ore, documenti e collegamenti con Varga Cantieri.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "allowDowngrades": false
    }
  }
}
